<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DocuSearch</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/search.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const currentUsername = "<%= username %>";
        const isAdmin = <%= isAdmin %>;
    </script>
    <script src="/js/search.js"></script>
</head>
<body>
    <div class="app-layout">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-header">
                <img src="/img/logot.svg" alt="DocuSearch" class="img-fluid logo">
            </div>

            <div class="sidebar-actions px-3 py-3 border-bottom">
                <button class="btn btn-sm btn-custom-grey w-100" data-bs-toggle="modal" data-bs-target="#createDbModal">
                    <i class="fas fa-plus"></i> New Database
                </button>
            </div>

            <div class="sidebar-content">
                <ul class="db-tree" id="dbTree">
                    <!-- Dynamic database tree injected here -->
                </ul>
            </div>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <i class="fas fa-user-circle"></i> <%= username %>
                </div>
                <div class="sidebar-footer-buttons">
                    <% if (isAdmin) { %>
                    <a href="/admin" class="btn btn-sm sidebar-footer-btn">
                        <i class="fas fa-cog"></i> Admin
                    </a>
                    <% } %>
                    <a href="/logout" class="btn btn-sm sidebar-footer-btn">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="top-bar d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
                <div class="active-context text-muted small fw-medium">
                    Searching in: <strong id="activeSearchDb" class="text-light">Main</strong>
                </div>
                <div class="top-bar-actions d-flex gap-2" id="topBarActions">
                    <button class="btn btn-sm btn-custom-grey" onclick="search.openUploadModal()"><i class="fas fa-file-upload"></i> Upload File</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="search.openTextModal()"><i class="fas fa-paste"></i> Paste Text</button>
                </div>
            </div>

            <div class="search-container">
                <div class="search-header">
                    <form id="searchForm" class="text-center">
                        <div class="input-group mx-auto search-group mb-2">
                            <input type="text" class="form-control search-input" id="searchQuery" placeholder="Enter search query..." required>
                            <input type="file" id="imageSearchInput" accept="image/*" class="d-none">
                            <div class="input-group-append d-flex">
                                <button type="button" class="search-image-btn" id="btnImageSearch" title="Search by Image">
                                    <i class="fas fa-camera"></i>
                                </button>
                                <button type="submit" class="btn btn-primary search-button">
                                    <i class="fas fa-search"></i> Search
                                </button>
                            </div>
                        </div>
                        <div class="form-check form-switch d-flex justify-content-center align-items-center gap-2 mt-2">
                            <input class="form-check-input" type="checkbox" id="searchTypeImageToggle" style="cursor: pointer;">
                            <label class="form-check-label text-muted small" for="searchTypeImageToggle" style="cursor: pointer;">Search specifically for Images (Text-to-Image)</label>
                        </div>
                    </form>
                </div>

                <div class="search-results" id="resultsContainer">
                    <div id="results" class="row"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Create DB Modal -->
    <div class="modal fade" id="createDbModal" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Create New Database</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label for="newDbName" class="form-label">Database Name</label>
                <input type="text" class="form-control" id="newDbName" placeholder="Enter name">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-custom-grey" id="btnCreateDb">Create</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Upload Document Modal -->
    <div class="modal fade" id="uploadDocModal" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Upload File to <span id="uploadTargetDb"></span></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label class="form-label">Select or Drag File(s) (.txt, .pdf, .png, etc)</label>
                <div id="dropZone" class="dropzone p-4 text-center border rounded mb-3" style="border: 2px dashed #32363b !important; cursor: pointer; background-color: #212327;">
                    <i class="fas fa-cloud-upload-alt fa-3x mb-3 text-muted"></i>
                    <p class="mb-1 text-light">Drag and drop files here</p>
                    <p class="text-muted small">or click to browse</p>
                    <input type="file" class="form-control d-none" id="docFile" multiple>
                </div>
            </div>

            <div id="uploadProgressContainer" class="mb-3" style="display: none;">
                <label class="form-label">Upload Progress</label>
                <div class="progress">
                  <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
                </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-custom-grey" id="btnUploadDoc">Upload</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Paste Text Modal -->
    <div class="modal fade" id="pasteTextModal" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Add Text to <span id="textTargetDb"></span></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label for="docTitle" class="form-label">Document Title</label>
                <input type="text" class="form-control" id="docTitle" placeholder="Enter title (e.g., Summary of Meeting)">
            </div>
            <div class="mb-3">
                <label for="docText" class="form-label">Content</label>
                <textarea class="form-control" id="docText" rows="6" placeholder="Paste your text here..."></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-custom-grey" id="btnPasteText">Save</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Manage Access Modal -->
    <div class="modal fade" id="manageAccessModal" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="manageAccessTitle">Manage Access</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div id="manageAccessUserList"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" class="btn btn-custom-grey" onclick="search.saveManageAccess()">Save Changes</button>
          </div>
        </div>
      </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchForm = document.getElementById('searchForm');
            const searchInput = document.getElementById('searchQuery');

            searchForm.addEventListener('submit', function (e) {
              search.handleSubmit(e);
            });
          });
    </script>
</body>
</html>
